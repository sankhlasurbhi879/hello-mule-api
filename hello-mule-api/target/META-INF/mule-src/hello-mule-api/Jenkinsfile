pipeline {
    agent any

    environment {
        MULE_ENV = "dev" // change as needed: dev, qa, prod
        ANYPOINT_USERNAME = credentials('anypoint-username')
        ANYPOINT_PASSWORD = credentials('anypoint-password')
        BUSINESS_GROUP = "YourBusinessGroupID"
        REGION = "us-east-1"
    }

    stages {
        stage('Build') {
            steps {
              
               bat 'env -B -U -e -V clean -DskipTests package'
            }
        }

        stage('Test') {
            steps {
                echo "Running unit tests..."
                bat "mvn test"
            }
        }

        stage('Deployment') {
            steps {
                echo " Deploying to CloudHub (${MULE_ENV})..."
                bat 'mvn -U -V -e -B -DskipTests deploy -Pdev -DmuleDeploy'
             
            }
        }
    }

 